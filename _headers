# Cloudflare Pages response headers
# https://developers.cloudflare.com/pages/configuration/headers/

# Audio files — immutable forever (content never changes)
/tawheed/audio/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD
  Accept-Ranges: bytes

# Catalog — short cache so metadata updates propagate within 1 hour
/tawheed/catalog.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

/tawheed-ar/catalog.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

# Series manifest — short cache, same as the per-series catalogs
/series.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

# Cover image — immutable
/tawheed/images/cover.jpg
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
